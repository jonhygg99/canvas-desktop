# Copia este archivo a `.env` y pon tu clave de Unsplash (gratis en
# unsplash.com/developers → Your apps → New Application). La app la lee al
# arrancar; sin ella la pestaña «Images» del editor no busca.
UNSPLASH_ACCESS_KEY=
# Clave de Serper.dev para la pestaña «Web» del editor (búsqueda de
# imágenes de Google; gratis 2.500 consultas en serper.dev). Sin ella la
# pestaña «Web» no busca. Cada llamada de 100 resultados ≈ 2 créditos.
SERPER_API_KEY=
